# ContextGhost Environment Variables Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String (Prisma format)
# Adjust user, password, host, port, and database name for your environment
DATABASE_URL="postgresql://sakshamsontakke:@localhost:5432/contextghost?schema=public"

# Local Ollama AI Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=120000

# Session Context Capture Settings
SESSION_MAX_CONTEXT_CHARS=30000
SESSION_MAX_LOG_BYTES=1048576
SESSION_SECRET_REDACTION=true

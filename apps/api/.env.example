# ContextGhost Backend API Environment Configuration
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# PostgreSQL Connection String (Prisma format)
DATABASE_URL=

# AI Provider Selection: 'openrouter' (default hosted), 'groq', or 'ollama' (local)
AI_PROVIDER=openrouter

# OpenRouter Hosted Open-Weight AI Provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Reliability Controls
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# Optional Alternative: Groq Cloud Provider
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Alternative: Local Offline Ollama Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=120000

# Session Context Capture Settings
SESSION_MAX_CONTEXT_CHARS=30000
SESSION_MAX_LOG_BYTES=1048576
SESSION_SECRET_REDACTION=true
